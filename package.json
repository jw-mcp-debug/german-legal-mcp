{
  "name": "@metaneutrons/german-legal-mcp",
  "version": "2.1.2",
  "description": "MCP server for German legal research",
  "main": "dist/index.js",
  "bin": {
    "german-legal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaneutrons/german-legal-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/metaneutrons/german-legal-mcp/issues"
  },
  "homepage": "https://github.com/metaneutrons/german-legal-mcp#readme",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "debug": "node --inspect dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "test:smoke": "node scripts/smoke-startup.mjs",
    "test:live": "GLMCP_RIS_LIVE=1 vitest run src/providers/ris/ris.live.test.ts",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run test:package && npm run test:smoke && npm audit --omit=dev --audit-level=high",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=25.0.0"
  },
  "keywords": [
    "mcp",
    "legal",
    "german",
    "law"
  ],
  "author": {
    "name": "Fabian Schmieder"
  },
  "license": "GPL-3.0",
  "type": "module",
  "lint-staged": {
    "package.json": [
      "npm audit --omit=dev --audit-level=high"
    ],
    "*.ts": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@upstash/redis": "^1.38.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "turndown": "^7.2.4",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "fast-check": "4.8.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "form-data": "4.0.6",
    "js-yaml": "4.2.0",
    "undici": "7.28.0"
  }
}
